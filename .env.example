# Dashboard, API, CLI login and MCP.
APP_URL=https://zup.example.com
# Uploaded sites. Must be a different host than APP_URL.
PREVIEW_URL=https://preview.example.com
# Signs sessions and encrypts keys. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional
# DATA_DIR=/data
# MAX_FILE_BYTES=1073741824          # 1 GiB per file
# MAX_DEPLOYMENT_BYTES=4294967296    # 4 GiB per deployment
# MAX_FILES=10000
# MCP_MAX_BODY_BYTES=67108864        # 64 MiB per MCP request
# CLIENT_IP_HEADER=x-forwarded-for   # set by Coolify's Traefik
