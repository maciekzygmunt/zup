---
// Dashboard screenshot that follows the visitor's color scheme.
interface Props {
  name: string
  alt: string
  width: number
  height: number
}
const { name, alt, width, height } = Astro.props
---

<figure class="overflow-hidden rounded-xl border border-line bg-card shadow-sm">
  <picture>
    <source srcset={`/screens/${name}-dark.png`} media="(prefers-color-scheme: dark)" />
    <img
      src={`/screens/${name}-light.png`}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="block w-full"
    />
  </picture>
</figure>
