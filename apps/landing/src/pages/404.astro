---
import Layout from "../components/Layout.astro"
---

<Layout title="Page not found — zup" description="This page does not exist.">
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-24 sm:pt-28">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="hero-title mt-2 max-w-[680px] text-5xl font-semibold tracking-tight">
      Nothing here.
    </h1>
    <p class="mt-6 max-w-[680px] text-lg text-muted">
      This page does not exist. The landing page is one page, and this is not it.
    </p>
    <a href="/" class="btn-primary mt-8">Back to the start</a>
  </section>
</Layout>
