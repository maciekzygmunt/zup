{
  "name": "zup",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@zup/server' --filter '@zup/web' dev",
    "build": "bun run --filter '@zup/web' build && bun run --filter '@zup/cli' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
